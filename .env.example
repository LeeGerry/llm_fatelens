PUBLIC_BASE_URL=http://localhost:8000
SERVER_URL=http://localhost:8000
CORS_ORIGINS=*
QDRANT_PATH=./local_qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=local_knowledge
