{
  "expo": {
    "name": "陈玉楼大师",
    "slug": "digital-human-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "digitalhuman",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.gerryli.digitalhumanmobile",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-audio",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "a5230a09-7858-4a06-8c97-ede8db0e8369"
      }
    }
  }
}
